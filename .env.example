# Copy to hr_agent/.env and fill in. Never commit .env (see .gitignore).

# Google ADK / Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global  # Gemini 3.x is served from "global", not regional endpoints
GOOGLE_GENAI_USE_ENTERPRISE=true
# TODO: retest gemini-3.8-flash; 70-150s/call on global on 2026-09-25 (bare SDK too)
MODEL_ID=gemini-3.5-flash-lite

# HCM MCP server the agent connects to (uv run python -m mcp_server.server)
HCM_MCP_URL=http://localhost:8000/mcp

# Set only when HCM_MCP_URL points at a private, IAM-gated Cloud Run service (its base URL,
# e.g. https://mcp-server-abc123-uc.a.run.app -- no path). When set, every HCM tool call
# attaches a Google-signed ID token for this audience so Cloud Run's IAM invoker check
# passes. Leave empty for local dev; local mcp_server has no IAM in front of it to satisfy.
HCM_MCP_AUDIENCE=
