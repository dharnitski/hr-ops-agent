# Copy to hr_agent/.env and fill in. Never commit .env (see .gitignore).

# Google ADK / Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global  # Gemini 3.x is served from "global", not regional endpoints
GOOGLE_GENAI_USE_ENTERPRISE=true
# TODO: retest gemini-3.8-flash; 70-150s/call on global on 2026-09-25 (bare SDK too)
MODEL_ID=gemini-3.5-flash-lite

# HCM system credentials (mcp_server/)
HCM_API_BASE_URL=
HCM_API_KEY=
