    {
      "eval_id": "happy_policy_pto_carryover",
      "conversation": [
        {
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "What's our PTO carryover policy?"
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Per the PTO carryover section of the handbook: up to 5 unused PTO days carry over into the next calendar year. Carried-over days expire on March 31 of the new year, and unused days above the 5-day cap are forfeited on December 31."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "name": "search_handbook",
                "args": {
                  "query": "PTO carryover"
                }
              }
            ]
          }
        }
      ]
    },
