    },
    {
      "eval_id": "adversarial_idempotency_replay_same_args",
      "conversation": [
        {
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "Submit a PTO request for Bob Smith from 2026-09-14 to 2026-09-16, use idempotency key demo-key-1."
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Submitted a PTO request for Bob Smith (E1002) from 2026-09-14 to 2026-09-16 (24.0 hours). It is pending approval."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "name": "transfer_to_agent",
                "args": {
                  "agent_name": "pto_agent"
                }
              },
              {
                "name": "find_employee",
                "args": {
                  "name": "Bob Smith"
                }
              },
              {
                "name": "submit_pto_request",
                "args": {
                  "employee_id": "E1002",
                  "start_date": "2026-09-14",
                  "end_date": "2026-09-16",
                  "idempotency_key": "demo-key-1"
                }
              }
            ]
          }
        },
        {
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "Please submit that same PTO request again with the same key, demo-key-1."
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "That request was already submitted (same idempotency key, same details) -- I haven't created a new one, this is the original request."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "name": "submit_pto_request",
                "args": {
                  "employee_id": "E1002",
                  "start_date": "2026-09-14",
                  "end_date": "2026-09-16",
                  "idempotency_key": "demo-key-1"
                }
              }
            ]
          },
          "rubrics": [
            {
              "rubric_id": "no_duplicate_created",
              "rubric_content": {
                "text_property": "The response indicates no new PTO request was created on this replay, and does not report submission details that differ from the original request."
              },
              "type": "FINAL_RESPONSE_QUALITY"
            }
          ]
        }
      ],
      "session_input": {
        "app_name": "hr_agent",
        "user_id": "test_user_id",
        "state": {
          "caller_employee_id": "E1002"
        }
      }
    },
    {
      "eval_id": "adversarial_idempotency_conflict_same_key_diff_args",
      "conversation": [
        {
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "Submit a PTO request for Bob Smith from 2026-09-14 to 2026-09-16, use idempotency key demo-key-2."
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Submitted a PTO request for Bob Smith (E1002) from 2026-09-14 to 2026-09-16 (24.0 hours). It is pending approval."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "name": "transfer_to_agent",
                "args": {
                  "agent_name": "pto_agent"
                }
              },
              {
                "name": "find_employee",
                "args": {
                  "name": "Bob Smith"
                }
              },
              {
                "name": "submit_pto_request",
                "args": {
                  "employee_id": "E1002",
                  "start_date": "2026-09-14",
                  "end_date": "2026-09-16",
                  "idempotency_key": "demo-key-2"
                }
              }
            ]
          }
        },
        {
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "Now use the same key, demo-key-2, but submit PTO for Bob Smith from 2026-10-01 to 2026-10-03 instead."
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "I can't do that: idempotency key 'demo-key-2' was already used for a different request (Sep 14-16). Use a new key for a new request."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "name": "submit_pto_request",
                "args": {
                  "employee_id": "E1002",
                  "start_date": "2026-10-01",
                  "end_date": "2026-10-03",
                  "idempotency_key": "demo-key-2"
                }
              }
            ]
          },
          "rubrics": [
            {
              "rubric_id": "reports_idempotency_conflict",
              "rubric_content": {
                "text_property": "The response reports that the idempotency key was already used with different arguments, and does not report the newly requested date range as submitted."
              },
              "type": "FINAL_RESPONSE_QUALITY"
            }
          ]
        }
      ],
      "session_input": {
        "app_name": "hr_agent",
        "user_id": "test_user_id",
        "state": {
          "caller_employee_id": "E1002"
        }
      }
    }
  ]
