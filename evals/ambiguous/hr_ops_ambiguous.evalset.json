      "conversation": [
        {
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "Is December 25, 2026 a company holiday, and how much sick time does E1002 have?"
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Yes, December 25, 2026 (Christmas Day) is a company holiday. Bob Smith (E1002) has 24.0 hours of sick leave remaining."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "name": "list_holidays",
                "args": {
                  "year": 2026
                }
              },
              {
                "name": "get_pto_balance",
                "args": {
                  "employee_id": "E1002"
                }
              }
            ]
          }
        }
      ],
      "session_input": {
        "app_name": "hr_agent",
        "user_id": "test_user_id",
        "state": {
          "caller_employee_id": "E1002"
        }
      }
    },
