{
  "eval_set_id": "hr_ops_ambiguous",
  "name": "HR Ops ambiguous",
  "description": "Requests with a missing or multi-valued detail the agent must resolve by asking, or by reusing session state -- not by guessing or declining. Includes regression cases for the M3/M4.4 router bugs.",
  "eval_cases": [
    {
      "eval_id": "ambiguous_missing_identity",
      "conversation": [
        {
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "How much PTO do I have left?"
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "I don't have a way to know who you are from this conversation. Could you give me your employee ID or full name?"
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": []
          }
        }
      ]
    },
    {
